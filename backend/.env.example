# Copy to .env before starting the stack:  cp .env.example .env
# Values below are the defaults that work with docker-compose as shipped.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Selects which credential set below is read: local | development | production
SYSTEM_ENV=local
HOST=0.0.0.0
PORT=8000

# Gunicorn
WORKERS_PER_CORE=1
MAX_WORKERS=4
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Application (pydantic Settings, APP_ prefix)
# ---------------------------------------------------------------------------
APP_LOGGING_LEVEL=INFO
APP_ROOT_PATH=

# Stateless caller identity. Generate a real secret for any shared deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_JWT_SECRET=dev-only-secret-change-me
APP_JWT_TTL_SECONDS=3600

# Seat lock lifecycle, in seconds
APP_SEAT_LOCK_TTL_SECONDS=120
APP_CHECKOUT_LOCK_TTL_SECONDS=600
APP_MAX_SEATS_PER_BOOKING=10

# ---------------------------------------------------------------------------
# MongoDB - catalog, bookings, seat reservations
# ---------------------------------------------------------------------------
# mongodb     -> a directly addressed host, such as the compose container
# mongodb+srv -> Atlas or any deployment discovered through DNS SRV records
MONGO1_SCHEME=mongodb
MONGO1_OPTIONS=authSource=admin
MONGO1_DB=cinema_booking

MONGO1_USER_LOCAL=cinema
MONGO1_PASSWORD_LOCAL=cinema_secret
MONGO1_HOST_LOCAL=mongo:27017

MONGO1_USER_DEV=
MONGO1_PASSWORD_DEV=
MONGO1_HOST_DEV=

MONGO1_USER_PROD=
MONGO1_PASSWORD_PROD=
MONGO1_HOST_PROD=

# ---------------------------------------------------------------------------
# Redis - seat locks and the real-time event stream
# ---------------------------------------------------------------------------
REDIS1_SCHEME=redis
REDIS1_DB=0

REDIS1_USER_LOCAL=
REDIS1_PASSWORD_LOCAL=
REDIS1_HOST_LOCAL=redis:6379

REDIS1_USER_DEV=
REDIS1_PASSWORD_DEV=
REDIS1_HOST_DEV=

REDIS1_USER_PROD=
REDIS1_PASSWORD_PROD=
REDIS1_HOST_PROD=

# ---------------------------------------------------------------------------
# Host port mappings for the datastore containers
# ---------------------------------------------------------------------------
MONGO_PORT=27017
REDIS_PORT=6379
