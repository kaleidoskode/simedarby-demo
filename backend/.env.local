# Settings for ENVIRONMENT=local — the docker compose stack.
#
# Committed on purpose. Everything here addresses containers on a private
# compose network and is useless to anyone outside it, so there is nothing to
# leak and nothing to copy before the first run: clone, `docker compose up`,
# done.
#
# `.env.development` and `.env.production` are the opposite — they hold real
# credentials, they are git-ignored, and you create them yourself. Copy the
# shape of this file; the variable names are identical, which is the point of
# splitting per environment rather than suffixing per variable.
#
# This is the ONLY .env.* file that git tracks.
# NEVER put a real secret in it.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
HOST=0.0.0.0

# 8000 everywhere, and there is no reason to change it: compose publishes 8000,
# a direct `python -m app.main` listens on 8000, and the demo client expects
# 8000. Only one of those runs at a time, so nothing has to be kept in step —
# and the frontend never has to be told which way the backend was started.
PORT=8000

# Gunicorn
WORKERS_PER_CORE=1
MAX_WORKERS=4
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Application (pydantic Settings, APP_ prefix)
# ---------------------------------------------------------------------------
APP_LOGGING_LEVEL=INFO
APP_ROOT_PATH=

# Stateless caller identity. Generate a real secret for any shared deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_JWT_SECRET=dev-only-secret-change-me
APP_JWT_TTL_SECONDS=3600

# Seat lock lifecycle, in seconds
APP_SEAT_LOCK_TTL_SECONDS=120
APP_CHECKOUT_LOCK_TTL_SECONDS=600
APP_MAX_SEATS_PER_BOOKING=10

# ---------------------------------------------------------------------------
# MongoDB — catalogue, bookings, seat reservations
# ---------------------------------------------------------------------------
# mongodb     -> a directly addressed host, such as the compose container
# mongodb+srv -> Atlas or any deployment discovered through DNS SRV records
MONGO1_SCHEME=mongodb
MONGO1_OPTIONS=authSource=admin
MONGO1_DB=cinema_booking

MONGO1_USER=cinema
MONGO1_PASSWORD=cinema_secret
MONGO1_HOST=mongo:27017

# ---------------------------------------------------------------------------
# Redis — seat locks and the real-time event stream
# ---------------------------------------------------------------------------
REDIS1_SCHEME=redis
REDIS1_DB=0

REDIS1_USER=
REDIS1_PASSWORD=
REDIS1_HOST=redis:6379

# There is deliberately nothing here for the datastores' *host* port mappings.
# Those are compose's business, not the application's — it never reads them —
# and compose cannot see this file when interpolating. They live in
# docker-compose.yml, overridable from the shell.
